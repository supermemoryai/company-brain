		"@modelcontextprotocol/sdk": "^1.24.3",
		"acorn": "^8.17.0",
		"agents": "^0.17.4",
		"ai": "^6.0.230",
		"ai-gateway-provider": "^3.1.3",
		"context.dev": "^2.19.0",
		"cron-schedule": "^6.0.0",
		"drizzle-orm": "^0.44.3",
