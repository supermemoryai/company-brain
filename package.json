{
	"name": "company-brain",
	"version": "0.1.0",
	"private": false,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build": "wrangler deploy --dry-run --outdir dist",
		"check-types": "tsc --noEmit && tsc --noEmit -p web",
		"db:generate": "drizzle-kit generate && bun scripts/bundle-migrations.ts",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate": "wrangler d1 migrations apply DB --remote",
		"test": "vitest run",
		"build:web": "bun web/build.ts"
	},
