{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": [],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@ui/*": ["./ui/*"],
			"@lib/*": ["./lib/*"],
			"@hooks/*": ["./hooks/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["build.ts"]
}
